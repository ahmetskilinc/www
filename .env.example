# Local database from docker-compose.yml (`docker compose up -d`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/portfolio
# Any long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=
# Optional: `bun run seed` creates this admin user if there are no users yet
SEED_ADMIN_EMAIL=admin@portfolio.test
SEED_ADMIN_PASSWORD=
